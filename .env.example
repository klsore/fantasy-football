YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
PORT=8000
# Optional Azure OpenAI integration. Off until explicitly enabled.
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
# Legacy shared AI gate (not used by the public/private sites).
MATCHUP_AI_PASSWORD=
AI_MONTHLY_REQUEST_LIMIT=20
AI_COOLDOWN_SECONDS=60
# Includes reasoning and visible output tokens.
AI_MAX_OUTPUT_TOKENS=4096
# Legacy only. New private-site cookies are always Secure.
AI_SECURE_COOKIE=false
# Initial private-site admin, created only when the users database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Explicit account-owned team allowed for daily public snapshots.
PUBLIC_LEAGUE_KEY=
PUBLIC_TEAM_KEY=
PUBLIC_HOST=fantasy.example.com
PRIVATE_HOST=fantasy.example.com
ACME_EMAIL=
